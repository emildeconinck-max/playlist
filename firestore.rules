rules_version = '2';
// Proof of concept: the admin panel has no login, so admin actions (list/rename/reset/delete
// accounts, delete messages, write the screen message) are open to anyone who uses the API directly.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function codePath(c) { return /databases/$(database)/documents/codes/$(c); }

    match /codes/{code} {
      allow get, list: if true;
      // codes are created by the admin panel; a new code is always unclaimed
      allow create: if code.lower() != 'admin'
        && request.resource.data.keys().hasOnly(['username'])
        && request.resource.data.username == null;
      // claim / rename (the matching usernames doc must be written in the same transaction) or reset (username null)
      allow update: if request.resource.data.keys().hasOnly(['username','claimedAt'])
        && (request.resource.data.username == null
          || (request.resource.data.username is string
            && request.resource.data.username.matches('^[^/]{2,20}$')
            && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))));
      allow delete: if true;
    }

    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      // update happens when the admin changes only the capitalisation of a name
      allow create, update: if request.resource.data.keys().hasOnly(['code'])
        && getAfter(codePath(request.resource.data.code)).data.username.lower() == name;
      allow delete: if true;
    }

    match /messages/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['code','username','text','ts'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.ts == request.time
        && get(codePath(request.resource.data.code)).data.username == request.resource.data.username;
      allow update: if false;
      allow delete: if true;
    }

    // the message the admin writes on everyone's screen (doc site/screen)
    match /site/{doc} {
      allow read: if true;
      allow write: if doc == 'screen'
        && request.resource.data.keys().hasOnly(['text','ts'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 280
        && request.resource.data.ts == request.time;
    }
  }
}
